<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copy to ~/Library/LaunchAgents/ and edit the two path strings below.
  Then: launchctl load ~/Library/LaunchAgents/com.resticweb.app.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.resticweb.app</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/restic-web</string>
    <string>-addr</string>
    <string>127.0.0.1:8080</string>
    <string>-data</string>
    <string>/Users/YOUR_USER/Library/Application Support/restic-web/data</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>DATABASE_URL</key>
    <string>postgres://YOUR_USER@127.0.0.1:5432/restic?sslmode=disable</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/YOUR_USER/Library/Logs/restic-web.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USER/Library/Logs/restic-web.log</string>
</dict>
</plist>
