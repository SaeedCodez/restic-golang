# Copy to .env and adjust for your machine:
#   cp .env.example .env
#
# Local Postgres (Homebrew / apt / Postgres.app). Create the database once:
#   createdb restic
#
# Socket auth (common on macOS Homebrew):
DATABASE_URL=postgres:///restic?host=/tmp&sslmode=disable
#
# Or TCP with a user/password:
# DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/restic?sslmode=disable
#
# Optional: point tests at a separate database
# TEST_DATABASE_URL=postgres:///restic_test?host=/tmp&sslmode=disable
